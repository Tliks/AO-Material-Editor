# target settings
msgid "targetSettings.title"
msgstr "Set Edit Targets"

msgid "targetSettings.mode.label"
msgstr "Mode"

msgid "targetSettings.mode.singleMaterial"
msgstr "Simple"

msgid "targetSettings.mode.singleMaterial.help"
msgstr "A basic mode for editing one material."

msgid "targetSettings.mode.bulkEdit"
msgstr "Bulk Edit"

msgid "targetSettings.mode.bulkEdit.help"
msgstr "Apply the same edits to multiple materials at once.\nThis is useful when you want to match their appearance and settings."

msgid "targetSettings.mode.bulkMaterials"
msgstr "Normal"

msgid "targetSettings.mode.slotTargets"
msgstr "Slot"

msgid "targetSettings.mode.slotTargets.help"
msgstr "Specify material slots instead of materials.\nThis is useful when you want to edit each usage location separately, or when you want to specify targets using paths.\nYou can specify multiple slots together, and the same edits will be applied to each of them. If multiple materials are assigned to a single slot, such as through animation, the same edits will also be applied to each of them."

msgid "targetSettings.mode.allMaterials"
msgstr "All"

msgid "targetSettings.mode.allMaterials.help"
msgstr "Target all materials. If needed, exclude targets from Options."

msgid "targetSettings.material.label"
msgstr "Target Material"

msgid "targetSettings.materials.label"
msgstr "Target Materials"

msgid "targetSettings.slotTargets.label"
msgstr "Target Material Slots"

msgid "targetSettings.exclusions.use"
msgstr "Exclude Targets"

msgid "targetSettings.exclusions.useSlots"
msgstr "Exclude Some Usage Slots"

msgid "targetSettings.exclusions.options"
msgstr "Options"

msgid "targetSettings.exclusions.useSlots.help"
msgstr "If a target material is used in multiple places, you can exclude some of them so edits are applied only to specific usage slots."

msgid "targetSettings.exclusions.materials"
msgstr "Materials to Exclude"

msgid "targetSettings.exclusions.slots"
msgstr "Slots to Exclude"

msgid "targetSettings.exclusions.objects"
msgstr "GameObjects to Exclude"

msgid "targetSettings.exclusions.selectUsageSlots"
msgstr "Select Usage Slots to Exclude"

msgid "targetSettings.dragAndDropAdd"
msgstr "Drop here to add\n(Materials / GameObjects / Meshes)"

# editor
msgid "editor.title"
msgstr "Edit Materials"

msgid "editor.help"
msgstr "You can edit the material from the editing screen below.\nYour edits are recorded automatically and saved to this component."

msgid "editor.showDescription"
msgstr "Help"

msgid "editor.noAvatarRoot.help"
msgstr "This component is currently disabled.\nIt is only active when placed under the avatar hierarchy."

msgid "editor.notEffective.help"
msgstr "This component is currently disabled.\nIt will not be applied when this component's checkbox is off, or when this GameObject is EditorOnly."

msgid "editor.noMaterialSelected.help"
msgstr "No material to edit was found. Configure it above."

msgid "editor.recordingSourceMaterial"
msgstr "Display Material"

msgid "editor.displaySettings"
msgstr "Editing Screen Display Settings"

# override settings
msgid "overrideSettings.count"
msgstr "Saved Edits: {0} items"

msgid "overrideSettings.help.visibleEditor"
msgstr "Saved edits are shown here. Changes made in the editing screen below are reflected automatically, so you usually do not need to edit this directly."

msgid "overrideSettings.help.hiddenEditor"
msgstr "Saved edits are shown here. Changes made after expanding the editing screen above are reflected automatically, so you usually do not need to edit this directly."

msgid "overrideSettings.help.noMaterial"
msgstr "Saved edits are shown here. The normal editing screen is hidden because no target material was found."

msgid "overrideSettings.properties"
msgstr "Properties"

msgid "overrideSettings.advancedSettings"
msgstr "Advanced Settings"

msgid "overrideSettings.reset"
msgstr "Reset"

